\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces Example computation of $\xi (\eta )$ for an unstable sandpile with lattice size $L=4$ and $\eta _c = 4$. Numbers written at each grid cell represent the sandpile height at vertex $(x, y)$, and correspond to the cell colour. $\eta $ is first toppled at site $\mathbf  {x}^{(1)} = (4, 4)$ to produce $\eta ^{(1)}$, which is also unstable. $\eta ^{(1)}$ is subsequently toppled at site $\mathbf  {x}^{(2)} = (4, 3)$ to produce $\eta ^{(2)} \in \Omega _{G_L}$. The algorithm terminates with $s(\eta )=2$. In the above example, we have $a(\eta ) = 2$, $\ell (\eta ) = 2 + 1 = 3$, and $d(\eta ) = 1$.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:toy_sandpiles}{{1.1}{3}{Example computation of $\xi (\eta )$ for an unstable sandpile with lattice size $L=4$ and $\eta _c = 4$. Numbers written at each grid cell represent the sandpile height at vertex $(x, y)$, and correspond to the cell colour. $\eta $ is first toppled at site $\mathbf {x}^{(1)} = (4, 4)$ to produce $\eta ^{(1)}$, which is also unstable. $\eta ^{(1)}$ is subsequently toppled at site $\mathbf {x}^{(2)} = (4, 3)$ to produce $\eta ^{(2)} \in \Omega _{G_L}$. The algorithm terminates with $s(\eta )=2$. In the above example, we have $a(\eta ) = 2$, $\ell (\eta ) = 2 + 1 = 3$, and $d(\eta ) = 1$}{figure.caption.1}{}}
