\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Visualisation of the stretched exponentially truncated power law probability mass function on log-log axes under different parameter combinations. Each point represents a discrete value and corresponding probability mass, with a line connecting sequential points for illustration purposes. The left three plots are identical to Figure \ref {fig:exp_powerlaw_params} as they keep $\beta = 1$. The right plot shows the effect of increasing $\beta $ while keeping $\tau $, $x_{max}$, and $c$ constant, which results in steeper decay.The orange line is identical in all plots, corresponding to parameters $\tau = 0.5$, $x_{max} = 100$, $c = 200$, and $\beta = 1$.}}{18}{figure.caption.15}\protected@file@percent }
\newlabel{fig:stretched_powerlaw_params}{{4.6}{18}{Visualisation of the stretched exponentially truncated power law probability mass function on log-log axes under different parameter combinations. Each point represents a discrete value and corresponding probability mass, with a line connecting sequential points for illustration purposes. The left three plots are identical to Figure \ref {fig:exp_powerlaw_params} as they keep $\beta = 1$. The right plot shows the effect of increasing $\beta $ while keeping $\tau $, $x_{max}$, and $c$ constant, which results in steeper decay.The orange line is identical in all plots, corresponding to parameters $\tau = 0.5$, $x_{max} = 100$, $c = 200$, and $\beta = 1$}{figure.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.3}{\ignorespaces Unpooled MLE power-law slopes $\tau $, soft cutoffs $c$, and stretching coefficient $\beta $ obtained for varying lattice sizes $L$.}}{19}{table.caption.16}\protected@file@percent }
\newlabel{tab:stretched_powerlaw_MLE}{{4.3}{19}{Unpooled MLE power-law slopes $\tau $, soft cutoffs $c$, and stretching coefficient $\beta $ obtained for varying lattice sizes $L$}{table.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Fitted MLEs for the unpooled stretched exponentially truncated power law distribution against the simulated data, for select lattice sizes $L = 5, 30, 100$. The full data fits are depicted in Appendix Figure \ref {fig:APPENDIX_stretched_powerlaw_mle_viz}. MLEs are drawn as black points with a connecting line drawn for illustration purposes. The left column shows avalanche size, while the right column shows avalanche area. The dashed vertical lines on the right show the bound on avalanche area, $L^2$. The additional flexibility of the stretching parameter is able to capture the tail behaviour of the pmfs.}}{19}{figure.caption.17}\protected@file@percent }
\newlabel{fig:stretched_unpooled_fit}{{4.7}{19}{Fitted MLEs for the unpooled stretched exponentially truncated power law distribution against the simulated data, for select lattice sizes $L = 5, 30, 100$. The full data fits are depicted in Appendix Figure \ref {fig:APPENDIX_stretched_powerlaw_mle_viz}. MLEs are drawn as black points with a connecting line drawn for illustration purposes. The left column shows avalanche size, while the right column shows avalanche area. The dashed vertical lines on the right show the bound on avalanche area, $L^2$. The additional flexibility of the stretching parameter is able to capture the tail behaviour of the pmfs}{figure.caption.17}{}}
\citation{}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces A comparison of the unpooled estimates of the parameters (points) with the pooled parameter estimates (dashed lines). If the pmf form and the finite size scaling hypothesis are appropriate, we expect the dashed line to approximate the trend of the points. Based on the above, the pooled model for avalanche area is reasonable, while evidence suggests avalanche size may have an $L-$dependent stretching parameter $\beta _s$.}}{20}{figure.caption.18}\protected@file@percent }
\newlabel{fig:stretched_pooled_unpooled_exp_comparison}{{4.8}{20}{A comparison of the unpooled estimates of the parameters (points) with the pooled parameter estimates (dashed lines). If the pmf form and the finite size scaling hypothesis are appropriate, we expect the dashed line to approximate the trend of the points. Based on the above, the pooled model for avalanche area is reasonable, while evidence suggests avalanche size may have an $L-$dependent stretching parameter $\beta _s$}{figure.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.4}{\ignorespaces Pooled MLE coefficients for finite size scaling assuming the stretched exponentially truncated power law distribution. We expect $\hat  {D} \approx 2$ and $\hat  {\tau } \approx 1$ for both avalanche area and size, so the results seem reasonable.}}{20}{figure.caption.18}\protected@file@percent }
\newlabel{tab:pooled_powerlaw_MLEs}{{4.4}{20}{Pooled MLE coefficients for finite size scaling assuming the stretched exponentially truncated power law distribution. We expect $\hat {D} \approx 2$ and $\hat {\tau } \approx 1$ for both avalanche area and size, so the results seem reasonable}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces Fitted MLEs for the pooled stretched exponentially truncated power law distribution against the simulated data, for select lattice sizes $L = 5, 30, 100$. The full data fits are depicted in Appendix Figure \ref {fig:APPENDIX_pooled_stretched_powerlaw_mle_viz}. MLEs are drawn as black points with a connecting line drawn for illustration purposes. The left column shows avalanche size, while the right column shows avalanche area. The dashed vertical lines on the right show the bound on avalanche area, $L^2$. The pooled fit degrades compared to the unpooled fit in Figure \ref {fig:stretched_unpooled_fit} for the avalanche size. This is consistent with avalanche size not following a finite size scaling rule. However, the fit is reasonable for avalanche area.}}{21}{figure.caption.19}\protected@file@percent }
\newlabel{fig:stretched_pooled_fit}{{4.9}{21}{Fitted MLEs for the pooled stretched exponentially truncated power law distribution against the simulated data, for select lattice sizes $L = 5, 30, 100$. The full data fits are depicted in Appendix Figure \ref {fig:APPENDIX_pooled_stretched_powerlaw_mle_viz}. MLEs are drawn as black points with a connecting line drawn for illustration purposes. The left column shows avalanche size, while the right column shows avalanche area. The dashed vertical lines on the right show the bound on avalanche area, $L^2$. The pooled fit degrades compared to the unpooled fit in Figure \ref {fig:stretched_unpooled_fit} for the avalanche size. This is consistent with avalanche size not following a finite size scaling rule. However, the fit is reasonable for avalanche area}{figure.caption.19}{}}
