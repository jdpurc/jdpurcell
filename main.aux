\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Fitted MLEs for the unpooled exponentially truncated power law distribution against the simulated data, for select lattice sizes $L = 5, 30, 100$. The full data fits are depicted in Appendix Figure \ref {fig:APPENDIX_exp_powerlaw_mle_viz}. MLEs are drawn as black points with a connecting line drawn for illustration purposes. The left column shows avalanche size, while the right column shows avalanche area. The dashed vertical lines on the right show the bound on avalanche area, $L^2$.}}{15}{figure.caption.12}\protected@file@percent }
\newlabel{fig:powerlaw_exp_fitted_mle}{{4.3}{15}{Fitted MLEs for the unpooled exponentially truncated power law distribution against the simulated data, for select lattice sizes $L = 5, 30, 100$. The full data fits are depicted in Appendix Figure \ref {fig:APPENDIX_exp_powerlaw_mle_viz}. MLEs are drawn as black points with a connecting line drawn for illustration purposes. The left column shows avalanche size, while the right column shows avalanche area. The dashed vertical lines on the right show the bound on avalanche area, $L^2$}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces A comparison of the unpooled estimates of the parameters (points) with the pooled parameter estimates (dashed lines). If the pmf form and the finite size scaling hypothesis are appropriate, we expect the dashed line to approximate the trend of the points. Based on the above, the model is not quite appropriate, and we need to consider an additional model for the pmf.}}{16}{figure.caption.13}\protected@file@percent }
\newlabel{fig:pooled_unpooled_exp_comparison}{{4.4}{16}{A comparison of the unpooled estimates of the parameters (points) with the pooled parameter estimates (dashed lines). If the pmf form and the finite size scaling hypothesis are appropriate, we expect the dashed line to approximate the trend of the points. Based on the above, the model is not quite appropriate, and we need to consider an additional model for the pmf}{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.2}{\ignorespaces Pooled MLE coefficients for finite size scaling assuming the exponentially truncated power law distribution. We expect $\hat  {D} \approx 2$ and $\hat  {\tau } \approx 1$ for both avalanche area and size, so the results seem reasonable.}}{16}{figure.caption.13}\protected@file@percent }
\newlabel{tab:pooled_powerlaw_MLEs}{{4.2}{16}{Pooled MLE coefficients for finite size scaling assuming the exponentially truncated power law distribution. We expect $\hat {D} \approx 2$ and $\hat {\tau } \approx 1$ for both avalanche area and size, so the results seem reasonable}{figure.caption.13}{}}
