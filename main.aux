\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Visualisation of the bounded power law probability mass function on log-log axes under different parameter combinations. Each point represents a discrete value and corresponding probability mass, with a line connecting sequential points for illustration purposes. The left plot shows the effect of varying $\tau $ while keeping $x_{max}$ constant, which results in changes to the slope and intercept of the connecting line. The right plot shows the effect of varying $x_{max}$ while keeping $\tau $ constant, which results in vertical translation of the connecting line, with different support for $x$. The orange line is identical in both plots, corresponding to parameters $\tau = 1$, $x_{max} = 100$.}}{9}{figure.caption.5}\protected@file@percent }
\newlabel{fig:powerlaw_params}{{3.1}{9}{Visualisation of the bounded power law probability mass function on log-log axes under different parameter combinations. Each point represents a discrete value and corresponding probability mass, with a line connecting sequential points for illustration purposes. The left plot shows the effect of varying $\tau $ while keeping $x_{max}$ constant, which results in changes to the slope and intercept of the connecting line. The right plot shows the effect of varying $x_{max}$ while keeping $\tau $ constant, which results in vertical translation of the connecting line, with different support for $x$. The orange line is identical in both plots, corresponding to parameters $\tau = 1$, $x_{max} = 100$}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Estimates for $\hat  {\tau }_s(L), \hat  {\tau }_a(L), \hat  {\tau }_d(L)$.}}{10}{figure.caption.6}\protected@file@percent }
