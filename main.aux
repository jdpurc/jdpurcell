\newlabel{fig:powerlaw_exp_taus}{{4.2}{14}{Estimates MLEs $\hat {\tau }_s(L), \hat {\tau }_a(L)$ (left) and $\hat {c}_s(L), \hat {c}_a(L)$ (right) for varying lattice sizes $L$}{figure.caption.11}{}}
