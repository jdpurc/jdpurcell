\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Observed frequencies of key avalanche statistics computed from the simulated sandpile Markov chain, excluding the discarded burn-in samples. A subset of four lattice sizes are depicted: 5, 10, 20, and 100, with varying colors. Values are computed from $10^6$ simulated observations. The dashed vertical lines on the Avalanche Area and $L_1$ Length plots correspond to the maximum possible values for each lattice size: $L^2$ and $2L$ respectively. Plots are shown in log-log axes. The appearance of horizontal lines is an artifact of the log-log axes. The lines correspond to sizes with only 1, 2, 3, etc. observations in the dataset, with exaggerated vertical distance between the lines because of the log scale.}}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:simulation_statistics}{{2.1}{8}{Observed frequencies of key avalanche statistics computed from the simulated sandpile Markov chain, excluding the discarded burn-in samples. A subset of four lattice sizes are depicted: 5, 10, 20, and 100, with varying colors. Values are computed from $10^6$ simulated observations. The dashed vertical lines on the Avalanche Area and $L_1$ Length plots correspond to the maximum possible values for each lattice size: $L^2$ and $2L$ respectively. Plots are shown in log-log axes. The appearance of horizontal lines is an artifact of the log-log axes. The lines correspond to sizes with only 1, 2, 3, etc. observations in the dataset, with exaggerated vertical distance between the lines because of the log scale}{figure.caption.4}{}}
