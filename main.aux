\@writefile{lot}{\contentsline {table}{\numberline {2.1}{\ignorespaces Runtime comparison between the \texttt  {numba}-based implementation and the standard Python implementation. The optimised code runs 100-140x faster. Simulations comprised 100,000 depositions (40,000 burn-in and 60,000 subsequent) and were performed on lattice sizes $L \in \{5, 7, 10, 12, 15\}$.}}{7}{table.caption.3}\protected@file@percent }
\newlabel{tab:runtime_comparison}{{2.1}{7}{Runtime comparison between the \texttt {numba}-based implementation and the standard Python implementation. The optimised code runs 100-140x faster. Simulations comprised 100,000 depositions (40,000 burn-in and 60,000 subsequent) and were performed on lattice sizes $L \in \{5, 7, 10, 12, 15\}$}{table.caption.3}{}}
